{
  "expo": {
    "name": "Inspira",
    "slug": "inspira-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#FAF6F0"
    },
    "assetBundlePatterns": [
      "*/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.app.inspira",
      "infoPlist": {
        "UIBackgroundModes": [
          "audio"
        ],
        "NSUserNotificationsUsageDescription": "Usamos notificações para lembrar você da leitura diária."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FAF6F0"
      },
      "package": "com.app.inspira",
      "permissions": [
        "SCHEDULE_EXACT_ALARM",
        "RECEIVE_BOOT_COMPLETED",
        "POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#C9A24B",
          "sounds": []
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "b255e794-ff06-40fb-abbc-38e96726722d"
      }
    }
  }
}